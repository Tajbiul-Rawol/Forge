<Project Sdk="Microsoft.NET.Sdk">
  <!-- A minimal Windows debugger for the PDB tests (tests/run.sh, mode "debug"). It runs a
       Forge .exe under the Win32 debug API and reads its PDB with dbghelp.dll, the symbol
       engine WinDbg uses: breakpoints by file:line and by name, backtraces (StackWalk64,
       which needs the .exe's unwind info), locals and struct fields, next, finish. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
