<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-process fuzzer for forgec. Compiles the compiler sources plus Fuzz.cs.
       Run: dotnet run -c Release (project tests/fuzz), arguments: iterations seed -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>ForgeC.Fuzz</StartupObject>
    <NoWarn>CS7022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../*.cs" />
    <Compile Include="Fuzz.cs" />
  </ItemGroup>
</Project>
