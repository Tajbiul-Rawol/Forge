module inline_asm;

// Inline assembly (Intel syntax). {name} is a Forge variable. Scratch registers
// (rax rcx rdx rsi rdi r8-r11) are free to use; save rbx, r12-r15 if you touch them.
// Runs on Windows and Linux; privileged instructions (cli, lidt, mov cr3, in/out)
// work the same way in a --target kernel build.

int SumTo(int n) {
    int result = 0;
    asm("mov rcx, {n}",
        "xor eax, eax",
        "again:",
        "add rax, rcx",
        "dec rcx",
        "jnz again",
        "mov {result}, rax");
    return result;
}

void Main() {
    // cpuid leaf 0: vendor string in ebx, edx, ecx (rbx is callee-saved: keep it)
    u8* v = malloc(16);
    long vp = (long)v;
    asm("push rbx",
        "xor eax, eax",
        "cpuid",
        "mov rax, {vp}",
        "mov dword ptr [rax], ebx",
        "mov dword ptr [rax+4], edx",
        "mov dword ptr [rax+8], ecx",
        "mov byte ptr [rax+12], 0",
        "pop rbx");
    string vendor = (string)v;
    Console.WriteLine($"vendor length {vendor.length}");
    Console.WriteLine(SumTo(100));                       // 5050

    // byte registers, shifts, setcc, memory with index*scale
    long[] arr = new long[4];
    arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;
    long base = (long)(u8*)arr;
    long x = 0;
    long flag = 0;
    asm("mov rsi, {base}",
        "mov rdx, 2",
        "mov rax, [rsi+rdx*8]",       // arr[2] = 30
        "add rax, qword ptr [rsi+8]",  // + arr[1] = 50
        "shl rax, 2",                  // 200
        "mov {x}, rax",
        "mov dil, 7",
        "cmp dil, 7",
        "sete al",
        "movzx eax, al",
        "mov {flag}, rax");
    Console.WriteLine($"{x} {flag}");                    // 200 1
    long t0 = rdtsc();
    long t1 = rdtsc();
    Console.WriteLine(t1 >= t0);
}
