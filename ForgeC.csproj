<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>forgec</AssemblyName>
    <!-- Compile ONLY the compiler's own sources. This prevents a stray file
         (e.g. a Program.cs left over from `dotnet new console`, or a second
         copy of the sources in a subfolder) from breaking the build with
         duplicate-type or multiple-entry-point errors. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Frontend.cs" />
    <Compile Include="Diagnostics.cs" />
    <Compile Include="Asm.cs" />
    <Compile Include="CodeGen.cs" />
    <Compile Include="Optimizer.cs" />
    <Compile Include="Threads.cs" />
    <Compile Include="InlineAsm.cs" />
    <Compile Include="AsyncRuntime.cs" />
    <Compile Include="Pe.cs" />
    <Compile Include="Elf32.cs" />
    <Compile Include="Driver.cs" />
  </ItemGroup>
</Project>
